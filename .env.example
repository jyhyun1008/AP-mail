# 브릿지 액터 정체성 — AP 핸들은 @<BRIDGE_USERNAME>@<BRIDGE_DOMAIN>이고,
# 대응되는 인바운드 이메일 주소는 <BRIDGE_USERNAME>@<BRIDGE_DOMAIN>입니다.
# BRIDGE_USERNAME은 내 실제 Misskey 계정의 로컬파트(@ 앞부분)로 맞춰서
# 둘이 일치하게 하세요.
BRIDGE_DOMAIN=mail.example.com
BRIDGE_USERNAME=jay
BRIDGE_ACTOR_TYPE=Service

# 이 브릿지가 반응할 유일한 액터 (내 실제 Misskey 계정).
# https://<misskey-도메인>/users/<id> — Misskey의 "원격 URL 복사" 기능으로 찾거나,
# acct:you@misskey.example.com을 WebFinger로 한 번 직접 조회해서 알아내세요.
ALLOWED_ACTOR_URI=https://misskey.example.com/users/xxxxxxxx

# HTTP 서버 (리버스 프록시 뒤에 둘 것; 호스트에 직접 노출하지 않음)
HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# 액터 키쌍 저장 위치 (영속 볼륨 — 재시작해도 남아있어야 함)
ACTOR_PRIVATE_KEY_PATH=./data/keys/actor-private.pem
ACTOR_PUBLIC_KEY_PATH=./data/keys/actor-public.pem

# SQLite
DB_PATH=./data/db/apmail.sqlite

# 인바운드 SMTP 리스너 (Postfix의 transport_maps가 여기로 메일을 넘겨줌).
# 127.0.0.1 기본값은 bare-metal 배포(Postfix랑 이 프로세스가 같은 서버, Docker
# 없이)에서 맞는 값입니다. docker/docker-compose.yml은 Docker의 포트 공개 기능이
# 필요로 하기 때문에 이 값을 알아서 0.0.0.0으로 덮어씁니다(그 파일 주석 참고) —
# Docker로 배포한다고 여기 값을 따로 바꿀 필요는 없고 그냥 이대로 두세요.
INBOUND_SMTP_HOST=127.0.0.1
INBOUND_SMTP_PORT=2525
# 인바운드 메시지 크기 상한 — Postfix 자체 제한 위에 한 겹 더 두는 방어.
INBOUND_MAX_MESSAGE_BYTES=10485760

# DM Note 하나에 넣을 이메일 본문 최대 글자수 — 여러분 Misskey 인스턴스의 노트 길이
# 제한 아래로 잡아두세요 (설정에서 maxNoteTextLength 확인, 기본값은 보통 ~3000).
DM_MAX_BODY_CHARS=2000

# 첨부파일 릴레이: 로컬 디스크에 저장되고, 이 브릿지 자신이
# https://<BRIDGE_DOMAIN>/media/<id>/<filename>으로 서빙해서 Misskey가 가져가
# 캐시하게 합니다.
ATTACHMENTS_DIR=./data/attachments
# 메일 하나당 첨부파일 총량 상한; 이걸 넘으면 첨부파일은 저장/릴레이되지 않고
# DM 텍스트에 파일명만 표시됩니다.
ATTACHMENTS_MAX_TOTAL_BYTES=8388608
# 첨부파일은 이 일수가 지나면 삭제됩니다 (`notes` 메타데이터 테이블은 이거랑
# 무관하게 무기한 보관됨 — 이 값은 디스크의 실제 파일에만 영향을 줌).
ATTACHMENTS_RETENTION_DAYS=30

# 아웃바운드 메일 릴레이 (Postfix가 어디 있든 — docs/dns-and-mail-setup.md 참고):
#   - bare metal, Postfix가 이 서버에 있을 때:        127.0.0.1
#   - docker/docker-compose.yml, Postfix가 이 서버에
#     있지만 Docker 밖에서 돌 때:                     host.docker.internal
#   - Postfix가 완전히 다른 서버에 있을 때:            그 서버의 실제 호스트명/IP,
#                                                    그리고 MAIL_RELAY_USER/PASS
#                                                    (SMTP AUTH — "로컬호스트니까
#                                                    신뢰"는 네트워크 너머로는
#                                                    적용 안 됨)
MAIL_RELAY_HOST=127.0.0.1
MAIL_RELAY_PORT=587
MAIL_RELAY_USER=
MAIL_RELAY_PASS=
MAIL_FROM_ADDRESS=jay@mail.example.com

# 원격 액터 공개키/inbox 캐시 TTL
ACTOR_CACHE_TTL_HOURS=24

LOG_LEVEL=info
