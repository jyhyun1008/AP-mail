# Bridge actor identity — the AP handle is @<BRIDGE_USERNAME>@<BRIDGE_DOMAIN>,
# and the matching inbound email address is <BRIDGE_USERNAME>@<BRIDGE_DOMAIN>.
# Set BRIDGE_USERNAME to your real Misskey account's local part so the two line up.
BRIDGE_DOMAIN=mail.example.com
BRIDGE_USERNAME=jay
BRIDGE_ACTOR_TYPE=Service

# The only actor whose activities this bridge will act on (your real Misskey account).
# https://<misskey-domain>/users/<id> — found via Misskey's own "copy remote URL"
# or by resolving acct:you@misskey.example.com through WebFinger once by hand.
ALLOWED_ACTOR_URI=https://misskey.example.com/users/xxxxxxxx

# HTTP server (reverse-proxied; not exposed to the host directly)
HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# Actor keypair storage (persisted volume — must survive restarts)
ACTOR_PRIVATE_KEY_PATH=./data/keys/actor-private.pem
ACTOR_PUBLIC_KEY_PATH=./data/keys/actor-public.pem

# SQLite
DB_PATH=./data/db/apmail.sqlite

# Inbound SMTP listener (Postfix transport_maps hands mail off to this).
# 127.0.0.1 default is correct for a bare-metal deploy (Postfix + this process on the
# same host, no Docker). docker/docker-compose.yml overrides this to 0.0.0.0 itself
# (see that file's comments) since Docker's port publishing needs it — you don't need
# to change this value for Docker deploys, just leave it as-is here.
INBOUND_SMTP_HOST=127.0.0.1
INBOUND_SMTP_PORT=2525
# Hard cap on inbound message size — defense in depth on top of Postfix's own limit.
INBOUND_MAX_MESSAGE_BYTES=10485760

# Max chars of email body embedded in one DM Note — keep under your Misskey instance's
# note length limit (Settings > check maxNoteTextLength, often ~3000 by default).
DM_MAX_BODY_CHARS=2000

# Attachment relay: saved to local disk, served by this same bridge at
# https://<BRIDGE_DOMAIN>/media/<id>/<filename> so Misskey can fetch+cache them.
ATTACHMENTS_DIR=./data/attachments
# Per-email cap on total attachment bytes; over this, attachments are named in the
# DM text but not saved/relayed.
ATTACHMENTS_MAX_TOTAL_BYTES=8388608
# Attachment files are deleted after this many days (the `notes` metadata table is
# kept indefinitely regardless — this only affects the binaries on disk).
ATTACHMENTS_RETENTION_DAYS=30

# Outbound mail relay (wherever Postfix ends up — see docs/dns-and-mail-setup.md):
#   - bare metal, Postfix on this same host:       127.0.0.1
#   - docker/docker-compose.yml, Postfix on this
#     same host but outside Docker:                host.docker.internal
#   - Postfix on a different host entirely:         its real hostname/IP, plus
#                                                    MAIL_RELAY_USER/PASS (SMTP AUTH —
#                                                    "trust localhost" won't apply
#                                                    across a network)
MAIL_RELAY_HOST=127.0.0.1
MAIL_RELAY_PORT=587
MAIL_RELAY_USER=
MAIL_RELAY_PASS=
MAIL_FROM_ADDRESS=jay@mail.example.com

# Remote actor public-key/inbox cache TTL
ACTOR_CACHE_TTL_HOURS=24

LOG_LEVEL=info
