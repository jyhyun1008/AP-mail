# Docker only honors .dockerignore at the build context root (repo root here, since
# the build is run as `docker build -f docker/Dockerfile .` from the repo root) —
# it does NOT look next to the Dockerfile itself, hence this lives here rather than
# under docker/.
node_modules
dist
data
.env
.env.*
!.env.example
*.pem
*.sqlite
*.sqlite-journal
.git
.github
test
docs
*.md
.DS_Store
npm-debug.log*
