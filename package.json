{
  "name": "apmail",
  "version": "0.1.0",
  "private": true,
  "description": "Personal mail <-> ActivityPub (Misskey) DM bridge",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/store && cp src/store/schema.sql dist/store/schema.sql",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-keys": "tsx scripts/gen-actor-keys.ts",
    "smoke:send-note": "tsx scripts/smoke-test-send-note.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.0",
    "mailparser": "^3.7.1",
    "nodemailer": "^9.0.5",
    "pino": "^9.4.0",
    "smtp-server": "^3.13.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^6.4.16",
    "@types/smtp-server": "^3.5.10",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
